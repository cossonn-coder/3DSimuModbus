{
  "schema_version": "0.2.0",
  "meta": {
    "project": "demo_carrousel_palettes",
    "description": "Convoyeur circulaire a palettes, 2 postes de blocage par verins monostables, cible M580 via I/O Scanner (2 lignes : FC3 lecture retours, FC16 ecriture commandes)",
    "authoring": "manuel (Phase 0, valide le 2026-07) - contrat que le pipeline Python devra produire en Phases 2/3",
    "units": { "length": "m", "time": "ms", "angle": "deg", "angular_speed": "deg/s" }
  },

  "modbus": {
    "port": 502,
    "unit_id": 1,
    "addressing_note": "%MWn cote Control Expert = holding register d'adresse protocole n cote serveur. Pas de decalage.",
    "zones": {
      "cmd": {
        "description": "PLC -> simulation (commandes). Ligne I/O Scanner en ecriture (FC16).",
        "base_mw": 100,
        "size_words": 1
      },
      "ret": {
        "description": "Simulation -> PLC (retours). Ligne I/O Scanner en lecture (FC3).",
        "base_mw": 200,
        "size_words": 2
      }
    },
    "heartbeat": {
      "description": "Compteur incremente par la simulation, rollover 16 bits libre. Permet au PLC de detecter une simulation figee.",
      "zone": "ret",
      "word": 0,
      "period_ms": 100
    }
  },

  "kinematics": {
    "path": {
      "type": "circle",
      "radius_m": 1.5,
      "center": [0.0, 0.0, 0.0],
      "direction": "ccw"
    },
    "pallets": {
      "count": 3,
      "size_m": [0.4, 0.1, 0.4],
      "initial_positions_deg": [0.0, 120.0, 240.0],
      "min_gap_deg": 20.0,
      "comment": "min_gap_deg = ecart angulaire minimal entre palettes (accumulation derriere une palette arretee)"
    }
  },

  "components": [
    {
      "id": "conveyor",
      "tag": "KM1",
      "type": "conveyor_circular",
      "params": {
        "speed_deg_per_s": 20.0,
        "feedback_delay_ms": 50
      },
      "signals": {
        "cmd_run": { "zone": "cmd", "word": 0, "bit": 0 },
        "ret_running": { "zone": "ret", "word": 1, "bit": 6, "tag": "KM1_AUX" }
      },
      "render": {
        "kind": "ring",
        "inner_radius_m": 1.3,
        "outer_radius_m": 1.7,
        "height_m": 0.05
      },
      "comment": "ret_running = contact auxiliaire du contacteur KM1 : recopie de cmd_run apres feedback_delay_ms (temps de fermeture du contacteur)"
    },
    {
      "id": "cylinder_1",
      "tag": "YV1",
      "type": "cylinder_blocker",
      "params": {
        "station_angle_deg": 90.0,
        "travel_time_ms": 500,
        "stroke_m": 0.15,
        "monostable": true,
        "block_threshold": 0.10,
        "retracted_threshold": 0.02,
        "extended_threshold": 0.98
      },
      "signals": {
        "cmd_extend": { "zone": "cmd", "word": 0, "bit": 1 },
        "ret_retracted": { "zone": "ret", "word": 1, "bit": 0, "tag": "S11" },
        "ret_extended": { "zone": "ret", "word": 1, "bit": 1, "tag": "S12" }
      }
    },
    {
      "id": "cylinder_2",
      "tag": "YV2",
      "type": "cylinder_blocker",
      "params": {
        "station_angle_deg": 270.0,
        "travel_time_ms": 500,
        "stroke_m": 0.15,
        "monostable": true,
        "block_threshold": 0.10,
        "retracted_threshold": 0.02,
        "extended_threshold": 0.98
      },
      "signals": {
        "cmd_extend": { "zone": "cmd", "word": 0, "bit": 2 },
        "ret_retracted": { "zone": "ret", "word": 1, "bit": 2, "tag": "S21" },
        "ret_extended": { "zone": "ret", "word": 1, "bit": 3, "tag": "S22" }
      }
    },
    {
      "id": "presence_station_1",
      "tag": "B1",
      "type": "sensor_presence",
      "params": {
        "station_angle_deg": 90.0,
        "window_deg": 8.0
      },
      "signals": {
        "ret_active": { "zone": "ret", "word": 1, "bit": 4 }
      }
    },
    {
      "id": "presence_station_2",
      "tag": "B2",
      "type": "sensor_presence",
      "params": {
        "station_angle_deg": 270.0,
        "window_deg": 8.0
      },
      "signals": {
        "ret_active": { "zone": "ret", "word": 1, "bit": 5 }
      }
    }
  ]
}
