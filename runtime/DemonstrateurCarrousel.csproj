<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Code defensif : on active le nullable pour attraper tot les references nulles
         (JSON pivot incomplet, buffers non initialises). -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serveur Modbus TCP. Version FIGEE apres le POC D-001 (2026-07-14) : 5.3.2
         validee (unit via AddUnit, buffer big-endian via Get/SetBigEndian, acces
         synchrone sous server.Lock). Voir docs/notes/NOTES_sprint_01.md. -->
    <PackageReference Include="FluentModbus" Version="5.3.2" />
  </ItemGroup>

  <!-- Lien vers la logique pure (loader pivot). La scene 3D (brique 5) construit sa geometrie
       depuis le PivotModel : elle a besoin du core, mais le core reste sans aucune dependance
       Godot (class library testee hors moteur). Le glob du SDK Godot exclut deja core/**/*.cs
       de la compilation directe (ci-dessus) ; c'est ce ProjectReference qui l'apporte proprement. -->
  <ItemGroup>
    <ProjectReference Include="core/CarrouselCore.csproj" />
    <!-- Serveur Modbus TCP (brique 3). La scene-hote (S2.1) demarre datastore + simulation +
         serveur a _Ready et les fait vivre dans _PhysicsProcess : elle a donc besoin de
         CarrouselServer, exactement comme SimHost. CarrouselServer tire lui-meme CarrouselCore
         et FluentModbus 5.3.2 (meme version que ci-dessus : aucun conflit au runtime Godot). -->
    <ProjectReference Include="server/CarrouselServer.csproj" />
  </ItemGroup>

  <!-- Sous-projets .NET autonomes sous runtime/ (POC jetable, class library core,
       tests xUnit) : ils ont leur PROPRE .csproj. On les retire du glob du SDK Godot,
       sinon l'assembly Godot tenterait de les compiler (top-level/points d'entree
       multiples => build casse). Le lien vers core se fera via un ProjectReference
       explicite quand la brique 1 sera livree. -->
  <ItemGroup>
    <Compile Remove="poc/**/*.cs" />
    <Compile Remove="core/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="server/**/*.cs" />
    <Compile Remove="server.tests/**/*.cs" />
    <Compile Remove="simhost/**/*.cs" />
  </ItemGroup>
</Project>
